# Crypto AI Terminal - Environment Variables Template
# Copy this file to .env.local and fill in your API keys

# ============================================
# KALSHI API CREDENTIALS (Required for Kalshi markets)
# ============================================
# Get your API credentials from: https://kalshi.com/
# You'll need to generate an API key from your account settings
KALSHI_KEY_ID=your_kalshi_key_id_here
KALSHI_PRIVATE_KEY=your_kalshi_private_key_here

# ============================================
# COINGLASS API (Optional - for enhanced liquidation data)
# ============================================
# Get your API key from: https://www.coinglass.com/
# This provides more comprehensive liquidation data across exchanges
COINGLASS_API_KEY=your_coinglass_api_key_here

# ============================================
# CUSTOM LIQUIDATION DATA SOURCE (Optional)
# ============================================
# If you have a custom endpoint for liquidation data, specify it here
# The API should return liquidation events in JSON format
COINAYZLE_URL=https://your-custom-endpoint.com/api/liquidations

# ============================================
# NOTES
# ============================================
# - Kalshi integration requires both KEY_ID and PRIVATE_KEY
# - Without Coinglass API key, the app will fallback to Binance public API
# - All APIs have rate limits - use responsibly
# - Keep your API keys secure and never commit them to version control
